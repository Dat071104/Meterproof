# Optional local-only overrides. Replace placeholders before copying to .env.
METERPROOF_POSTGRES_USER=<local-only-user>
METERPROOF_POSTGRES_PASSWORD=<local-only-password>
METERPROOF_POSTGRES_DB=<local-database-name>

# Local loopback ports and bounded logical-WAL settings.
METERPROOF_POSTGRES_PORT=54329
METERPROOF_KAFKA_PORT=29092
METERPROOF_CONNECT_PORT=8083
METERPROOF_FLINK_PORT=8081
METERPROOF_WAL_LEVEL=logical
METERPROOF_MAX_WAL_SENDERS=4
METERPROOF_MAX_REPLICATION_SLOTS=4
METERPROOF_MAX_SLOT_WAL_KEEP_SIZE=1024MB
METERPROOF_SHARED_BUFFERS=128MB
