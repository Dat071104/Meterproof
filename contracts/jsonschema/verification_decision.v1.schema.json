{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meterproof.local/contracts/verification-decision.v1.schema.json",
  "title": "Verification decision and comparison distinct v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "origin",
    "run_id",
    "manifest_sha256",
    "scope",
    "comparison_status",
    "business_verdict",
    "coverage_summary",
    "source_exclusions",
    "test_receipts",
    "published_eligible"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "run_id": {
      "type": "string"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope": {
      "type": "string"
    },
    "comparison_status": {
      "enum": [
        "EQUAL",
        "DIFFERENT",
        "NOT_COMPARABLE",
        "ERROR"
      ]
    },
    "business_verdict": {
      "enum": [
        "VERIFIED",
        "MISMATCH",
        "INCOMPLETE",
        "UNDETERMINED"
      ]
    },
    "coverage_summary": {
      "type": "string"
    },
    "source_exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affected_business_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test_receipts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policy_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "published_eligible": {
      "type": "boolean"
    },
    "origin": {
      "enum": [
        "PRODUCTION",
        "PILOT",
        "SANDBOX",
        "SYNTHETIC"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "published_eligible": {
            "const": true
          }
        },
        "required": [
          "published_eligible"
        ]
      },
      "then": {
        "properties": {
          "business_verdict": {
            "const": "VERIFIED"
          },
          "comparison_status": {
            "const": "EQUAL"
          }
        },
        "required": [
          "business_verdict",
          "comparison_status"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "business_verdict": {
            "const": "VERIFIED"
          }
        },
        "required": [
          "business_verdict"
        ]
      },
      "then": {
        "properties": {
          "comparison_status": {
            "const": "EQUAL"
          },
          "unresolved_items": {
            "type": "array",
            "maxItems": 0
          }
        },
        "required": [
          "comparison_status",
          "unresolved_items"
        ]
      }
    }
  ]
}
